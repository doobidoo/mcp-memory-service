  "cards": [
    {
      "dot": "cyan",
      "title": "Three ways in",
      "items": [
        "stdio: default mode of memory server, no network",
        "Streamable HTTP: MCP for claude.ai and ChatGPT, OAuth 2.1 or API key",
        "REST: /api/* for frameworks and the dashboard"
      ]
    },
    {
      "dot": "emerald",
      "title": "One tool surface",
      "items": [
        "stdio and Streamable HTTP share MemoryServer",
        "The remote transport filters tools that read local file paths",
        "REST handlers use the storage layer directly"
      ]
    },
    {
      "dot": "violet",
      "title": "Storage",
      "items": [
        "SQLite-vec, Cloudflare, Hybrid and Milvus implement MemoryStorage",
        "Hybrid reads from SQLite-vec and syncs to Cloudflare in the background"
      ]
    },
    {
      "dot": "amber",
      "title": "Scope",
      "items": [
        "Snapshot at the pinned commit, written from the source",
        "Dashboard, hooks and document ingestion are not drawn",
        "Auth is enforced when OAuth or an API key is configured"
      ]
    }
  ]
