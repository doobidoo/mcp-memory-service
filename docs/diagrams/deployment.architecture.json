  "cards": [
    {
      "dot": "cyan",
      "title": "Exactly one publisher",
      "items": [
        "release.yml on a GitHub-hosted runner owns PyPI and Docker Hub",
        "Codeberg lost its Actions secrets on 5 September 2026 and can no longer publish",
        "A tag must be pushed with git; one created through a forge API fires nothing"
      ]
    },
    {
      "dot": "rose",
      "title": "One-way streets",
      "items": [
        "GitLab only ever receives a fast-forwarded main, and never tags",
        "GitHub Pages serves a redirect stub, not content",
        "Nothing pushes to Codeberg any more; it stays readable so old links resolve"
      ]
    },
    {
      "dot": "amber",
      "title": "What the move retired",
      "items": [
        "Releases no longer depend on one Hetzner VM; hosted runners replaced it",
        "The Forgejo runner on tinyclaw still exists but has no job",
        "The Gitea mirror still points at Codeberg; its state is unverified since the move"
      ]
    }
  ]
